{
  "name": "radiology-report-assistant",
  "version": "1.0.0",
  "description": "Professional radiology report assistant with DICOM viewer, AI generation, and clinical workflow",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "cd apps/client && npm run dev",
    "dev:server": "cd apps/server && npm run dev",
    "build": "npm run build:server && npm run build:client",
    "build:client": "cd apps/client && npm run build",
    "build:server": "cd apps/server && npm run build",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  }
}
